<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 scales the complete icon canvas. Keep the logo small inside it. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="288dp" android:height="288dp" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <item android:width="48dp" android:height="48dp"
        android:gravity="center" android:drawable="@drawable/parchapp_logo" />
</layer-list>
